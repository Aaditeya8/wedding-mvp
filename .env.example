# Leave DATABASE_URL unset locally to use embedded PGlite at var/pglite
DATABASE_URL=
AUTH_SECRET=generate-with-openssl-rand-base64-33
# Fallback only — live links are built from the request host (src/lib/origin.ts).
# Used by the seed script and tests, which have no request to read.
APP_URL=http://localhost:3000
# smtp needs SMTP_USER + SMTP_PASS; anything else records mail in the `outbox`
# table (readable at /admin/mailroom) instead of sending.
EMAIL_MODE=file            # file | smtp
SMTP_USER=you@gmail.com
SMTP_PASS=gmail-app-password
EMAIL_FROM="Ananya & Arjun <you@gmail.com>"
# Seeded staff logins, comma-separated, in role order:
# admin, couple, committee, committee, couple-of-second-wedding.
# Unset = @example.com placeholders (fine for EMAIL_MODE=file, where magic links
# are written to var/outbox/mail.jsonl instead of being delivered).
SEED_STAFF_EMAILS=
# Optional: AI-assisted column matching in the guest-list import (/committee/import).
# Any OpenAI-compatible endpoint works; defaults are Groq's free tier + gpt-oss-120b.
# Leave AI_API_KEY empty and the import still works with the built-in name-based matcher.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Reads photos of handwritten/printed guest lists (needs AI_API_KEY too)
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
